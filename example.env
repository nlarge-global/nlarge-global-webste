# Public site URL
NEXT_PUBLIC_SITE_URL=https://nlargecorp.com

# SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Contact recipients
CONTACT_GENERAL_EMAIL=info@nlargecorp.com
CONTACT_SUPPORT_EMAIL=support@nlargecorp.com

# Optional distributed rate limiting (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated LAN origins allowed by Next.js dev server
DEV_ALLOWED_ORIGINS=10.21.47.118
