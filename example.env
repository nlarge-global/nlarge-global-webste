# Public site URL
NEXT_PUBLIC_SITE_URL=https://nlargecorp.com

# MongoDB
MONGODB_URI=

# Admin authentication and encryption (used in later implementation steps)
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_VERSION=v1

# Private Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Contact recipients
CONTACT_GENERAL_EMAIL=info@nlargecorp.com
CONTACT_SUPPORT_EMAIL=support@nlargecorp.com

# Optional distributed rate limiting (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated LAN origins allowed by Next.js dev server
DEV_ALLOWED_ORIGINS=10.21.47.118
